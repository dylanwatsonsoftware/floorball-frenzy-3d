#!/bin/sh
set -eu

if [ ! -f build/web/index.html ]; then
	echo "Missing build/web/index.html; run scripts/export-web first." >&2
	exit 1
fi

rm -rf .vercel/output
mkdir -p .vercel/output/static
cp -R build/web/. .vercel/output/static/
mkdir -p .vercel/output/functions/api/matchmaking.func
cp server/matchmaking.mjs .vercel/output/functions/api/matchmaking.func/index.mjs
cp server/redis_client.mjs .vercel/output/functions/api/matchmaking.func/redis_client.mjs

cat > .vercel/output/functions/api/matchmaking.func/.vc-config.json <<'JSON'
{
  "runtime": "nodejs24.x",
  "handler": "index.mjs",
  "launcherType": "Nodejs"
}
JSON

cat > .vercel/output/config.json <<'JSON'
{
  "version": 3,
  "routes": [
    {
      "src": "/api/ice-servers",
      "dest": "https://floorball-frenzy.vercel.app/api/ice-servers"
    },
    {
      "src": "/api/(lobby|signal)",
      "dest": "/api/matchmaking?endpoint=$1"
    },
    {
      "src": "/.*\\.wasm$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/.*\\.pck$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(index\\.html|index\\.service\\.worker\\.js|index\\.manifest\\.json)$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    }
  ],
  "overrides": {
    "index.wasm": {
      "contentType": "application/wasm"
    },
    "index.pck": {
      "contentType": "application/octet-stream"
    }
  }
}
JSON

echo "Packaged Vercel Build Output in .vercel/output."
